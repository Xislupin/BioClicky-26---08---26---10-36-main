<!-- Contêiner visual: a navegação é identificada pela tag nav interna. -->
<div class="admin-nav">
    <a
        href="/admin/dashboard"
        class="admin-logo"
    >BioClicky <small>Admin</small>
    </a>
    <!-- aria-current identifica a página atual também para leitores de tela. -->
    <nav aria-label="Menu administrativo">
        <a
            href="/admin/dashboard"
            aria-current="<%= rotaAtual === '/admin/dashboard' ? 'page' : 'false' %>"
        >Resumo</a>
        <a
            href="/admin/usuarios"
            aria-current="<%= rotaAtual === '/admin/usuarios' ? 'page' : 'false' %>"
        >Usuários</a>
        <a
            href="/admin/medicamentos"
            aria-current="<%= rotaAtual === '/admin/medicamentos' ? 'page' : 'false' %>"
        >Medicamentos</a>
        <a
            href="/admin/farmacias"
            aria-current="<%= rotaAtual === '/admin/farmacias' ? 'page' : 'false' %>"
        >Farmácias</a>
        <a
            href="/admin/categorias"
            aria-current="<%= rotaAtual === '/admin/categorias' ? 'page' : 'false' %>"
        >Categorias</a>
        <a
            href="/admin/relatorios"
            aria-current="<%= rotaAtual === '/admin/relatorios' ? 'page' : 'false' %>"
        >Relatórios</a>
        <a
            href="/admin/configuracoes"
            aria-current="<%= rotaAtual === '/admin/configuracoes' ? 'page' : 'false' %>"
        >Configurações</a>
    </nav>
    <!-- Envia os campos para a rota indicada em action; method define GET ou POST. -->
    <form
        action="/admin/logout"
        method="POST"
    >
        <button class="admin-sair">Sair</button>
    </form>
</div>
