<!DOCTYPE html>
<html lang="pt-BR">
<!-- Configura título, estilos e scripts da página. -->

<head>
    <title>Recuperar senha — BioClicky</title>
    <!-- Reutiliza o arquivo parcial indicado, evitando copiar o mesmo código. -->
    <%- include('../partials/head', { cssPagina: 'auth' }) %>
</head>

<body class="auth-body">
    <!-- Conteúdo principal desta página. -->
    <main class="auth-layout">
        <!-- Agrupa uma seção do conteúdo. -->
        <section class="auth-apresentacao">
            <%- include('../partials/auth-top') %>
            <div>
                <h1>Recuperação de senha</h1>
                <p>Esta tela demonstra o fluxo que poderá ser ligado ao serviço de e-mail.</p>
            </div>
            <a href="/login">← Voltar ao login</a>
        </section>
        <!-- Agrupa uma seção do conteúdo. -->
        <section class="auth-formulario">
            <!-- Envia os campos para a rota indicada em action; method define GET ou POST. -->
            <form
                action="/senha"
                method="POST"
                class="auth-card"
            >
                <h2>Esqueceu a senha?</h2>
                <!-- Mostra este trecho somente quando a condição for verdadeira. -->
                <% if (enviado) { %>
                    <p class="mensagem sucesso">Se o e-mail estiver cadastrado, enviaremos as
                        instruções.</p>
                <% } %>
                <!-- Identifica o campo pelo mesmo valor de for e id. -->
                <label for="email">E-mail cadastrado</label>
                <input
                    id="email"
                    type="email"
                    name="email"
                    required
                >
                <button class="botao-principal">Enviar instruções</button>
            </form>
        </section>
    </main>
</body>

</html>
