<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Acesso Administrativo - BioClicky</title>

    <link rel="stylesheet" href="/css/admin.css">

    <!-- Ionicons -->
    <script type="module" src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.esm.js"></script>
    <script nomodule src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.js"></script>
</head>

<body>

    <main class="admin-page">

        <section class="admin-card">

            <header class="admin-header">

                <a href="/" class="logo">
                    <span class="logo-icon">
                        <ion-icon name="add"></ion-icon>
                    </span>

                    <span>BioClicky</span>
                </a>

                <span class="admin-badge">
                    <ion-icon name="shield-checkmark-outline"></ion-icon>
                    Acesso Administrativo
                </span>

                <h1>Área restrita</h1>

                <p>Somente administradores autorizados</p>

            </header>

            <% if (typeof erro !== 'undefined' && erro) { %>
                <p class="error-message">
                    <ion-icon name="alert-circle-outline"></ion-icon>
                    <%= erro %>
                </p>
            <% } %>

            <form action="/admin/login" method="POST" class="admin-form">

                <label for="email">Email</label>

                <fieldset class="input-box">
                    <ion-icon name="mail-outline"></ion-icon>

                    <input
                        type="email"
                        id="email"
                        name="email"
                        placeholder="admin@bioclicky.com.br"
                        autocomplete="email"
                        required
                    >
                </fieldset>


                <label for="senha">Senha</label>

                <fieldset class="input-box password-box">
                    <ion-icon name="lock-closed-outline"></ion-icon>

                    <input
                        type="password"
                        id="senha"
                        name="senha"
                        placeholder="•••••••••"
                        autocomplete="current-password"
                        required
                    >

                    <button
                        type="button"
                        class="show-password"
                        onclick="mostrarSenha()"
                        aria-label="Mostrar senha"
                    >
                        <ion-icon name="eye-outline" id="eye-icon"></ion-icon>
                    </button>
                </fieldset>


                <button type="submit" class="admin-button">
                    Entrar como Admin
                </button>

            </form>

            <p class="demo">
                Demo: admin@bioclicky.com.br / admin123
            </p>

            <a href="/" class="back-link">
                ← Voltar ao site
            </a>

        </section>

    </main>


    <script>
        function mostrarSenha() {
            const senha = document.getElementById("senha");
            const icon = document.getElementById("eye-icon");

            if (senha.type === "password") {
                senha.type = "text";
                icon.setAttribute("name", "eye-off-outline");
            } else {
                senha.type = "password";
                icon.setAttribute("name", "eye-outline");
            }
        }
    </script>

</body>
</html>