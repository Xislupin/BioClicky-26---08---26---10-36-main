<!DOCTYPE html>
<html lang="pt-BR">
<!-- Configura título, estilos e scripts da página. -->

<head>
    <title>Painel administrativo — BioClicky</title>
    <!-- Reutiliza o arquivo parcial indicado, evitando copiar o mesmo código. -->
    <%- include('../partials/head', { cssPagina: 'admin' }) %>
</head>

<body class="admin-body">
    <%- include('../partials/admin-nav') %>
    <main class="admin-main">
        <!-- Cabeçalho da página ou desta seção. -->
        <header class="admin-topo">
            <div>
                <span class="sobrelinha">Visão geral</span>
                <h1>Painel administrativo</h1>
                <p>Olá, <%= admin %>. Acompanhe os dados principais do protótipo.</p>
            </div>
        </header>
        <!-- Lista de descrições: dt nomeia o indicador e dd informa seu valor. -->
        <dl class="admin-estatisticas" aria-label="Resumo dos indicadores">
            <div>
                <dt>
                    <ion-icon name="people-outline" aria-hidden="true"></ion-icon>
                    Usuários
                </dt>
                <dd><%= estatisticas.usuarios %></dd>
            </div>
            <div>
                <dt>
                    <ion-icon name="search-outline" aria-hidden="true"></ion-icon>
                    Pesquisas
                </dt>
                <dd><%= estatisticas.pesquisas %></dd>
            </div>
            <div>
                <dt>
                    <ion-icon name="medkit-outline" aria-hidden="true"></ion-icon>
                    Medicamentos
                </dt>
                <dd><%= estatisticas.medicamentos %></dd>
            </div>
            <div>
                <dt>
                    <ion-icon name="business-outline" aria-hidden="true"></ion-icon>
                    Farmácias
                </dt>
                <dd><%= estatisticas.farmacias %></dd>
            </div>
        </dl>
        <!-- Agrupa uma seção do conteúdo. -->
        <section class="admin-bloco">
            <h2>Ações rápidas</h2>
            <div class="admin-acoes">
                <a href="/admin/medicamentos">Gerenciar medicamentos</a>
                <a href="/admin/farmacias">Gerenciar farmácias</a>
                <a href="/admin/relatorios">Ver relatórios</a>
            </div>
        </section>
    </main>
</body>

</html>
