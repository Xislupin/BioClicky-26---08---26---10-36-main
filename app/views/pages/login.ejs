<!DOCTYPE html>
<html lang="pt-BR">
<!-- Configura título, estilos e scripts da página. -->

<head>
    <title>Entrar — BioClicky</title>
    <%- include('../partials/head', { cssPagina: 'auth' }) %>
    <script
        src="/js/auth.js"
        defer
    >
    </script>
</head>

<body class="auth-body">
    <!-- Conteúdo principal desta página. -->
    <main class="auth-layout">
        <!-- Agrupa uma seção do conteúdo. -->
        <section class="auth-apresentacao">
            <%- include('../partials/auth-top') %>
            <div>
                <span class="sobrelinha">Bem-vindo</span>
                <h1>Compare preços com mais facilidade</h1>
                <p>Entre para salvar sua localização e seus dados de contato.</p>
            </div>
            <a href="/">← Continuar sem entrar</a>
        </section>
        <!-- Agrupa uma seção do conteúdo. -->
        <section class="auth-formulario">
            <!-- Envia os campos para a rota indicada em action; method define GET ou POST. -->
            <form
                action="/login"
                method="POST"
                class="auth-card"
            >
                <h2>Entrar</h2>
                <p>Informe seus dados de acesso.</p>
                <!-- Mostra este trecho somente quando a condição for verdadeira. -->
                <% if (erro) { %>
                    <p
                        class="mensagem erro"
                        role="alert"
                    ><%= erro %></p>
                <% } %>
                <!-- Identifica o campo pelo mesmo valor de for e id. -->
                <label for="email">E-mail</label>
                <input
                    id="email"
                    name="email"
                    type="email"
                    autocomplete="email"
                    required
                >
                <div class="label-linha">
                    <label for="senha">Senha</label>
                    <a href="/senha">Esqueci minha senha</a>
                </div>
                <div class="campo-senha">
                    <input
                        id="senha"
                        name="senha"
                        type="password"
                        minlength="6"
                        autocomplete="current-password"
                        required
                    >
                    <button
                        type="button"
                        class="mostrar-senha"
                        aria-label="Mostrar senha"
                    >
                        <ion-icon name="eye-outline">
                        </ion-icon>
                    </button>
                </div>
                <button class="botao-principal">Entrar</button>
                <p class="auth-link">Ainda não tem conta? <a href="/cadastro">Criar conta</a>
                </p>
            </form>
        </section>
    </main>
</body>

</html>
