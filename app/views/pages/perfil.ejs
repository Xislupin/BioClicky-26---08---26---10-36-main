<!DOCTYPE html><html lang="pt-BR"><head><title>Meu perfil — BioClicky</title><%- include('../partials/head', { cssPagina: 'perfil' }) %></head><body><%- include('../partials/header') %><main class="secao perfil-pagina"><header><span class="sobrelinha">Minha conta</span><h1>Olá, <%= nome %></h1><p>Atualize os dados usados para personalizar sua experiência.</p></header><section class="perfil-card"><% if (salvo) { %><p class="mensagem sucesso">Alterações salvas com sucesso.</p><% } %><form action="/perfil" method="POST"><label for="email">E-mail</label><input id="email" value="<%= email %>" readonly><label for="telefone">Telefone</label><input id="telefone" name="telefone" type="tel" value="<%= telefone %>" placeholder="(11) 99999-9999"><label for="localizacao">Cidade e estado</label><input id="localizacao" name="localizacao" value="<%= localizacao %>"><button class="botao-principal">Salvar alterações</button></form><form action="/sair" method="POST"><button class="botao-secundario">Sair da conta</button></form></section></main><%- include('../partials/footer') %></body></html>
