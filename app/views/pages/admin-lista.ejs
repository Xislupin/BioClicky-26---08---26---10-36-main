<!DOCTYPE html>
<html lang="pt-BR">
<!-- Configura título, estilos e scripts da página. -->

<head>
    <title><%= titulo %> — Administração</title>
    <!-- Reutiliza o arquivo parcial indicado, evitando copiar o mesmo código. -->
    <%- include('../partials/head', { cssPagina: 'admin' }) %>
</head>

<body class="admin-body">
    <%- include('../partials/admin-nav') %>
    <main class="admin-main">
        <!-- Cabeçalho da página ou desta seção. -->
        <header class="admin-topo">
            <div>
                <span class="sobrelinha">Gerenciamento</span>
                <h1><%= titulo %></h1>
                <p>Dados demonstrativos usados no protótipo do TCC.</p>
            </div>
            <button
                class="botao-principal"
                type="button"
            >Adicionar</button>
        </header>
        <!-- Agrupa uma seção do conteúdo. -->
        <section class="admin-tabela">
            <div class="tabela-cabecalho">
                <span>Nome</span>
                <span>Detalhes</span>
                <span>Status</span>
            </div>
            <!-- Repete este trecho para cada item enviado pela rota. -->
            <% itens.forEach(item => { %>
                <article>
                    <strong><%= item.nome %></strong>
                    <span><%= item.detalhe %></span>
                    <span class="status"><%= item.status %></span>
                </article>
            <% }) %>
        </section>
    </main>
</body>

</html>
