<!DOCTYPE html>
<html lang="pt-BR">
<!-- Configura título, estilos e scripts da página. -->

<head>
    <title><%= titulo %> — Administração</title>
    <!-- Reutiliza o arquivo parcial indicado, evitando copiar o mesmo código. -->
    <%- include('../partials/head', { cssPagina: 'admin' }) %>
</head>

<body class="admin-body">
    <%- include('../partials/admin-nav') %>
    <main class="admin-main">
        <!-- Cabeçalho da página ou desta seção. -->
        <header class="admin-topo">
            <div>
                <span class="sobrelinha">Gerenciamento</span>
                <h1><%= titulo %></h1>
                <p>Dados demonstrativos usados no protótipo do TCC.</p>
            </div>
            <button
                class="botao-principal"
                type="button"
            >Adicionar</button>
        </header>
        <!-- A região pode ser rolada pelo teclado quando a tabela exceder a tela. -->
        <div
            class="admin-tabela"
            role="region"
            aria-label="Lista de <%= titulo.toLowerCase() %>"
            tabindex="0"
        >
            <!-- Tabela nativa: associa cada valor ao cabeçalho da sua coluna. -->
            <table>
                <caption class="sr-only">Lista de <%= titulo.toLowerCase() %></caption>
                <thead>
                    <tr>
                        <th scope="col">Nome</th>
                        <th scope="col">Detalhes</th>
                        <th scope="col"><%= tipo === 'medicamentos' ? 'Menor preço' : 'Status' %></th>
                    </tr>
                </thead>
                <tbody>
                    <!-- Cada registro é uma linha; o nome identifica essa linha. -->
                    <% itens.forEach(item => { %>
                        <tr>
                            <th scope="row"><%= item.nome %></th>
                            <td><%= item.detalhe %></td>
                            <td class="status"><%= item.status %></td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </main>
</body>

</html>
